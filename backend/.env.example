# ============================================================
# Backend Environment Variables — Meeting Summarizer
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it contains secrets!
# ============================================================

# --- Gemini AI ---
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Supabase ---
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://yhrudyzoypevgajmtqsn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlocnVkeXpveXBldmdham10cXNuIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzIyMDc1NywiZXhwIjoyMTAyNzk2NzU3fQ.EBHeAywPpJE62ObFlRUt925RWR5ZisXGt1e4b8eu_WE

# --- CORS (allowed frontend origin) ---
# Local dev: http://localhost:5173
# Production: your Vercel URL (e.g., https://meeting-summarizer.vercel.app)
FRONTEND_URL=http://localhost:5173

# --- Server ---
# The port uvicorn will listen on (Render sets this automatically in production)
PORT=8000

# --- Zoom Integration (User-level OAuth 2.0) ---
# Create an OAuth app at https://marketplace.zoom.us/
# Set OAuth Redirect URL to: https://meeting-summarizer-rfrr.onrender.com/api/zoom/callback
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_REDIRECT_URI=https://meeting-summarizer-rfrr.onrender.com/api/zoom/callback
# Generate a secure 32-byte url-safe base64 key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZOOM_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here

# --- Zoom RTMS (Realtime Media Streams Live Summarization) ---
# Secret token from Zoom Marketplace App > Features > Event Subscriptions
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token_here
RTMS_BUFFER_FLUSH_INTERVAL_SECONDS=25
RTMS_MIN_WORDS_PER_CHUNK=30
